---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// Real links are added only after the publishing review (docs/publishing.md).
const links: Array<{ label: string; href: string }> = [
  { label: t('contact.github'), href: '#' },
  { label: t('contact.linkedin'), href: '#' },
];
---

<BaseLayout title={t('contact.heading')} locale={locale}>
  <section class="prose">
    <h1>{t('contact.heading')}</h1>
    <p>{t('contact.body')}</p>
    <ul>
      {links.map(({ label, href }) => <li><a href={href} rel="me">{label}</a></li>)}
    </ul>
  </section>
</BaseLayout>
