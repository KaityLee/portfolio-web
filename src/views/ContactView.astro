---
import { ui as t, type Locale } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout title={t['contact.heading']} locale={locale}>
  <section class="prose narrow">
    <h1>{t['contact.heading']}</h1>
    <p>{t['contact.body']}</p>
  </section>
</BaseLayout>
