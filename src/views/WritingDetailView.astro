---
import { render, type CollectionEntry } from 'astro:content';

import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleShell from '../components/ArticleShell.astro';
import PrevNext from '../components/PrevNext.astro';
import type { Locale } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListed } from '../lib/content';

interface Props {
  entry: CollectionEntry<'writing'>;
  alternates: Partial<Record<Locale, string>>;
  locale: Locale;
}

const { entry, alternates, locale } = Astro.props;
const { Content, headings } = await render(entry);
const unlisted = entry.data.visibility === 'restricted';

// Neighbours among listed posts only (newest first), so unlisted posts never leak into navigation.
const listed = await getListed('writing', locale);
const index = listed.findIndex((e) => e.id === entry.id);
const newer = index > 0 ? listed[index - 1] : undefined;
const older = index >= 0 && index < listed.length - 1 ? listed[index + 1] : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={locale}
  alternates={alternates}
  noindex={unlisted}
  ogType="article"
>
  <ArticleShell headings={headings} locale={locale}>
    <header slot="header" class="article-header">
      <h1>{entry.data.title}</h1>
      <ArticleMeta entry={entry} locale={locale} />
    </header>
    <Content />
    <PrevNext slot="footer" collection="writing" prev={older} next={newer} locale={locale} />
  </ArticleShell>
</BaseLayout>
