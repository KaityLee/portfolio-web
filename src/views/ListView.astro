---
import PostList from '../components/PostList.astro';
import PostRows from '../components/PostRows.astro';
import { headLang, useTranslations, type Locale } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListed, type ContentCollection } from '../lib/content';

interface Props {
  collection: ContentCollection;
  locale: Locale;
}

const { collection, locale } = Astro.props;
const t = useTranslations(locale);
const entries = await getListed(collection, locale);
const heading = collection === 'projects' ? t('projects.heading') : t('writing.heading');
const lead = collection === 'projects' ? t('projects.lead') : t('writing.lead');
---

<BaseLayout title={heading} locale={locale}>
  <section class="index-page">
    <h1 lang={headLang(locale)}>{heading}</h1>
    <p class="lead">{lead}</p>
    {
      collection === 'projects'
        ? <PostList collection={collection} entries={entries} locale={locale} />
        : <PostRows collection={collection} entries={entries} locale={locale} detailed />
    }
  </section>
</BaseLayout>
