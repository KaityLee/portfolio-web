---
import PostList from '../components/PostList.astro';
import type { Locale } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListed } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = (await getListed('projects', locale)).slice(0, 3);
const writing = (await getListed('writing', locale)).slice(0, 3);
---

<BaseLayout title={t('nav.home')} locale={locale}>
  <section class="hero">
    <h1>{t('home.heading')}</h1>
    <p class="lead">{t('home.lead')}</p>
  </section>
  <section>
    <div class="section-head">
      <h2>{t('home.recentProjects')}</h2>
      <a href={localizePath('/projects', locale)}>{t('home.viewAll')}</a>
    </div>
    <PostList collection="projects" entries={projects} locale={locale} />
  </section>
  <section>
    <div class="section-head">
      <h2>{t('home.recentWriting')}</h2>
      <a href={localizePath('/writing', locale)}>{t('home.viewAll')}</a>
    </div>
    <PostList collection="writing" entries={writing} locale={locale} />
  </section>
</BaseLayout>
