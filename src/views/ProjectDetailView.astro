---
import { render, type CollectionEntry } from 'astro:content';

import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleShell from '../components/ArticleShell.astro';
import { ui as t, uiLanguage, type Locale } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  alternates: Partial<Record<Locale, string>>;
  locale: Locale;
}

const { entry, alternates, locale } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const readingMinutes: number | undefined = remarkPluginFrontmatter?.readingMinutes;
const unlisted = entry.data.visibility === 'restricted';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={locale}
  alternates={alternates}
  noindex={unlisted}
  ogType="article"
>
  <ArticleShell headings={headings} locale={locale}>
    <header slot="header" class="article-header">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      <dl class="facts">
        {entry.data.role && (<><dt lang={uiLanguage}>{t['projects.role']}</dt><dd>{entry.data.role}</dd></>)}
        {entry.data.period && (<><dt lang={uiLanguage}>{t['projects.period']}</dt><dd>{entry.data.period}</dd></>)}
        {
          entry.data.stack.length > 0 && (
            <>
              <dt lang={uiLanguage}>{t['projects.stack']}</dt>
              <dd class="tags">
                {entry.data.stack.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </dd>
            </>
          )
        }
        {entry.data.repo && (<><dt lang={uiLanguage}>{t['projects.repo']}</dt><dd><a href={entry.data.repo}>{entry.data.repo}</a></dd></>)}
      </dl>
      <ArticleMeta entry={entry} readingMinutes={readingMinutes} />
    </header>
    <Content />
  </ArticleShell>
</BaseLayout>
