---
// Home hero band (DESIGN.md §7): a notebook grid with a few connected nodes, like a small
// knowledge graph. Decorative only; drawn for this site (LICENSES.md). Colors come from tokens.
---

<div class="hero-band" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 320" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <pattern id="hero-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="12" cy="12" r="1.3" class="hero-dot" />
      </pattern>
    </defs>
    <rect width="1200" height="320" fill="url(#hero-grid)" />
    <g class="hero-links" fill="none" stroke-width="2" stroke-linecap="round">
      <path d="M180 230 C 260 120, 340 110, 420 170" />
      <path d="M420 170 C 500 230, 560 240, 640 160" />
      <path d="M640 160 C 700 100, 760 90, 820 130" />
      <path d="M820 130 C 900 180, 960 250, 1040 210" />
      <path d="M420 170 C 460 260, 540 280, 600 262" />
      <path d="M640 160 C 660 80, 720 60, 790 72" />
      <path d="M180 230 C 140 300, 90 300, 60 262" />
    </g>
    <g class="hero-nodes">
      <circle cx="180" cy="230" r="9" class="node-primary" />
      <circle cx="420" cy="170" r="12" class="node-secondary" />
      <circle cx="640" cy="160" r="9" class="node-primary" />
      <circle cx="820" cy="130" r="7" class="node-primary" />
      <circle cx="1040" cy="210" r="10" class="node-secondary" />
      <circle cx="600" cy="262" r="6" class="node-primary" />
      <circle cx="790" cy="72" r="6" class="node-secondary" />
      <circle cx="60" cy="262" r="6" class="node-primary" />
    </g>
  </svg>
</div>
