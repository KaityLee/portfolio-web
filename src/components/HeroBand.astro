---
// An original decorative scatter plot with fixed coordinates. The plot is not empirical data.
const points = [
  [4, 75], [10, 67], [16, 73], [22, 61], [75, 31], [82, 26], [91, 19], [96, 24],
  [6, 84], [9, 76], [14, 83], [15, 64], [18, 68], [24, 75], [27, 65], [31, 72], [34, 57],
  [66, 46], [71, 41], [76, 48], [78, 39], [84, 40], [86, 28], [90, 34], [94, 12], [98, 16],
] as const;
---

<div class="hero-band" aria-hidden="true">
  <div class="hero-plot">
    {points.map(([x, y]) => <span class="plot-point" style={`--plot-x: ${x}%; --plot-y: ${y}%;`}></span>)}
  </div>
</div>
