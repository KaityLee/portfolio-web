---
import { useTranslations, type Locale } from '../i18n/ui';
import { entryPath, type ContentCollection, type ContentEntry } from '../lib/content';
import { formatDate, toDateTimeAttr } from '../utils/date';

interface Props {
  collection: ContentCollection;
  entries: ContentEntry[];
  locale: Locale;
  headingLevel?: 2 | 3;
}

const { collection, entries, locale, headingLevel = 2 } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

{
  entries.length === 0 ? (
    <p class="meta">{t('common.empty')}</p>
  ) : (
    <ul class="post-list">
      {entries.map((entry) => (
        <li>
          <Heading>
            <a href={entryPath(collection, entry, locale)} lang={entry.data.lang}>{entry.data.title}</a>
          </Heading>
          <p lang={entry.data.lang}>{entry.data.summary}</p>
          <div class="meta">
            <time datetime={toDateTimeAttr(entry.data.date)}>{formatDate(entry.data.date, locale)}</time>
            {entry.data.tags.length > 0 && (
              <span class="tags" lang={entry.data.lang}>
                {entry.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
