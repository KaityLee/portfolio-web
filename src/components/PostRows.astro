---
// Compact date-and-title rows on home; featured summaries and tags on the writing index.
import { useTranslations, type Locale } from '../i18n/ui';
import { entryPath, type ContentCollection, type ContentEntry } from '../lib/content';
import { formatDate, toDateTimeAttr } from '../utils/date';

interface Props {
  collection: ContentCollection;
  entries: ContentEntry[];
  locale: Locale;
  detailed?: boolean;
}

const { collection, entries, locale, detailed = false } = Astro.props;
const t = useTranslations(locale);
---

{
  entries.length === 0 ? (
    <p class="meta">{t('common.empty')}</p>
  ) : (
    <ol class="post-rows">
      {entries.map((entry) => (
        <li>
          <time datetime={toDateTimeAttr(entry.data.date)}>{formatDate(entry.data.date, locale)}</time>
          <div class="post-row-content" lang={entry.data.lang}>
            <a href={entryPath(collection, entry, locale)}>{entry.data.title}</a>
            {detailed && entry.data.featured && <p>{entry.data.summary}</p>}
            {detailed && entry.data.tags.length > 0 && (
              <div class="tags">
                {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}
