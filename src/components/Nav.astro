---
// Site navigation. On phones it is a popover sheet under the header opened by the menu button
// (native popover API, no JS library); from 768px it renders inline. The Home item is only
// shown in the sheet because the brand link is Home on desktop (DESIGN.md §7).
import type { Locale } from '../i18n/ui';
import { localizePath, stripLocale, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';

const items: Array<{ path: string; label: string; sheetOnly?: boolean }> = [
  { path: '/', label: t('nav.home'), sheetOnly: true },
  { path: '/writing', label: t('nav.writing') },
  { path: '/projects', label: t('nav.projects') },
  { path: '/about', label: t('nav.about') },
  { path: '/contact', label: t('nav.contact') },
];

function isCurrent(path: string): boolean {
  return path === '/' ? current === '/' : current === path || current.startsWith(`${path}/`);
}
---

<nav id="site-menu" class="site-nav" popover aria-label={t('nav.menu')}>
  <ul>
    {
      items.map(({ path, label, sheetOnly }) => (
        <li class:list={{ 'sheet-only': sheetOnly }}>
          <a href={localizePath(path, locale)} aria-current={isCurrent(path) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="sheet-only sheet-tools">
    <slot />
  </div>
</nav>
